# Copy this file to ".env" and edit it. NEVER commit ".env" (it is in .gitignore).

# Local MongoDB. If your MongoDB needs a username/password, put it in the URI here (in .env only).
MONGO_URI=mongodb://localhost:27017
DB_NAME=smart_school_dev

# A long random text used to sign login cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-paste-a-long-random-value-here
